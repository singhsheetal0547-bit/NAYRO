<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="sharedpref" path="." />
    <!-- Exclude encrypted API key storage and sensitive local database from unencrypted cloud backup (Phase 7) -->
    <exclude domain="sharedpref" path="nayro_secure_prefs.xml" />
    <exclude domain="sharedpref" path="nayro_encrypted_keystore_prefs.xml" />
    <exclude domain="database" path="nayro_local_db" />
    <exclude domain="database" path="nayro_local_db-shm" />
    <exclude domain="database" path="nayro_local_db-wal" />
</full-backup-content>
